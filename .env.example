# ── Configurações da aplicação ────────────────────────────────
# Copie este arquivo para .env e preencha os valores

# Chave da API Groq (gratuita em https://console.groq.com)
GROQ_API_KEY=sua_chave_aqui

# Modelo LLM (opções Groq gratuitas)
# llama-3.1-70b-versatile | llama-3.1-8b-instant | mixtral-8x7b-32768
LLM_MODEL=llama-3.1-70b-versatile

# Modelo de Embeddings (HuggingFace — roda localmente, sem custo)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Diretório de persistência do ChromaDB
CHROMA_PERSIST_DIR=./vectorstore/chroma_db

# Configurações de chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Número de chunks recuperados pelo retriever
RETRIEVAL_K=4
